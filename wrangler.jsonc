{
  "name": "cloudlare-multplayer",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "ChessRoom" },
      { "name": "USER", "class_name": "UserStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChessRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["UserStore"] }
  ]
}
